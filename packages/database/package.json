{
  "name": "@marquee/database",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL schema, reviewed SQL migrations, repositories and the integration-test harness.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./test-harness": "./src/test-harness.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate-cli.ts"
  },
  "dependencies": {
    "@marquee/domain": "0.1.0",
    "@marquee/observability": "0.1.0",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "@marquee/spatial": "0.1.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
