{
  "name": "marquee",
  "private": true,
  "version": "0.1.0",
  "description": "Venue-owner SaaS for wedding halls, marriage halls and marquees (Pakistan first).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:api": "npm run dev -w @marquee/api",
    "dev:web": "npm run dev -w @marquee/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --config vitest.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "db:migrate": "npm run db:migrate -w @marquee/database",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:db": "tsx scripts/dev-db.ts",
    "dev:worker": "npm run dev -w @marquee/worker"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "embedded-postgres": "17.11.0-beta.19",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
