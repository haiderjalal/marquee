# Copy to .env.local (web) and .env (api). Never commit real values.

# --- API (apps/api) ---------------------------------------------------------
API_PORT=4000
# PostgreSQL connection string. Use an isolated database per environment.
DATABASE_URL=postgres://postgres:marquee-dev-only@127.0.0.1:54329/marquee_dev
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000
# Authentication mode. "dev" accepts x-dev-user-id headers and is refused when
# NODE_ENV=production. Replace with the chosen OIDC provider (see docs/adr).
AUTH_MODE=dev
LOG_LEVEL=info

# --- Web (apps/web) ---------------------------------------------------------
# Server-side base URL used by Server Components.
API_INTERNAL_URL=http://localhost:4000
# Browser-visible base URL (no secrets here).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Dev-only staff identity used by the staff workspace until OIDC is wired.
DEV_STAFF_USER_ID=00000000-0000-4000-8000-000000000001

# --- Tests ------------------------------------------------------------------
# Optional: point integration tests at an existing PostgreSQL instead of the
# embedded binary. The database must be empty or disposable.
TEST_DATABASE_URL=
